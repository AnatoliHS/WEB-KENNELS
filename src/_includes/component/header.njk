<style>

    @font-face {
        font-family: 'Inertia';
        src: url('/abc.otf') format('opentype'); 
        font-weight: normal;
        font-style: normal;
    }

    .header {
        display: flex;
        width: 90vw;
        justify-content: center;
        align-items: center;
        margin-top: 40px;         
        height: 200px; 
        position: relative; 
        min-width: 370px;     
    }

    .header-background {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%; z-index: 0;
    }

    .header-background img {
        width: 100%; height: 100%; object-fit: cover; opacity: 0.5; 
        border-radius: 15px;
        box-shadow: -3px -4px 8px rgba(255, 255, 255, 0.9), 2px 3px 5px rgba(0, 0, 0, 0.5); 
    }

    .logo {
        z-index: 1;
        width: 100%;
        text-align: center;
        display: flex;       /* Added to center the image perfectly */
        justify-content: center;
        align-items: center;
    }

    /* --- DESKTOP TEXT (Visible by default) --- */
    .logo-text {
        display: block;      /* Visible on desktop */
        font-family: 'Inertia', sans-serif;
        font-weight: bold;
        margin: 0; 
        line-height: 1; 
        background: linear-gradient(to right, #191f4f 0%, #436aee 20%, #91e0fd 50%, #dbbbf6 60%, #2c3c94 100%);
        -webkit-background-clip: text; 
        background-clip: text;         
        -webkit-text-fill-color: transparent;
        color: transparent;
        filter: 
            drop-shadow(0.5px 0.5px 0 black) 
            drop-shadow(-0.5px -0.5px 0 black)
            drop-shadow(0.5px -0.5px 0 black)
            drop-shadow(-0.5px 0.5px 0 black);
        font-size: clamp(50px, 14vw, 120px);
    }

    .highlight-blue { color: inherit; }

    /* --- MOBILE LETTER (Hidden by default) --- */
/* --- MOBILE IMAGE (Hidden by default) --- */
    .mobile-logo {
        display: none;       /* Hidden on desktop */
        max-height: 100px;   /* Adjust size as needed */
        width: auto;
        object-fit: contain;
    }

    
    /* --- MOBILE MEDIA QUERY --- */
@media (max-width: 768px) {
    .header {
        margin-top: 50px;
        height: 250px; 
        min-width: auto; 
    }

    /* HIDE FULL TEXT */
    .logo-text {
        display: none;
    }

    /* SHOW SINGLE LETTER */
    .mobile-logo {
        display: block;
        /* 2. Increase height percentage and add a max-height for control */
        height: 100%;    
        max-height: 100px; 
        width: auto;
        object-fit: contain;
        /* 3. Optional: Add a slight transform if you want it to "pop" out of the container */
        transform: scale(1.1); 
    }
}
</style>


<div class="header">
    <div class="logo">
        <p class="logo-text">
            <span class="highlight-blue">Chas</span>Tech
        </p>
        <img src="/assets/logologo2.png" alt="ChasTech Logo" class="mobile-logo">
    </div>
</div>