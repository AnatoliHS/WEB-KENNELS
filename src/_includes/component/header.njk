<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simple Header</title>
    <style>
        body {
           
        }

        .header {
            display: flex;
            width: 90vw;
            justify-content: center;
            align-items: center;
            margin-top: 50px;         
            height: 200px;
            direction: flex;
            position: relative; 
            min-width: 370px;     
               
            
        }

        .header-background {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            
        }

        .header-background img {
            width: 100%;
            height: 100%;
            object-fit: cover;
           opacity: 0.5; 
           border-radius: 15px;
            box-shadow: -3px -4px 8px rgba(255, 255, 255, 0.9), 2px 3px 5px rgba(0, 0, 0, 0.5); 
        }

        .logo{
            z-index: 1;
        }

       
           
        
        
    </style>
</head>
<body>

    <div class="header">

        <div class="header-background">
            <img " src="/assets/dental10.jpg" alt="Logo">
        </div>
    
        <div class="logo" >
        <img style="--h: auto; width: 27vw; min-width: 280px; max-width: 400px; " src="/assets/whimiswise.png" alt="Logo">
        
        
        </div>
        
      
    </div>

    <!-- Additional content goes here -->
</body>