                <li class="copyright-text">&copy; 2026 ChasTech Inc.</li>
            </ul>
        </div>
    </div>
</footer>

<style>
    /* --- MICRO FOOTER CONTAINER --- */
    .site-footer {
        width: 100%;
        background-color: #f2f8fc;
        padding: 20px 20px; 
        box-shadow: 0 -5px 15px rgba(0, 0, 0, 0.03);
        box-sizing: border-box;
        border-top: 1px solid rgba(25, 31, 79, 0.05);
    }

    .footer-content {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center; 
        gap: 20px;
    }

    /* --- BRANDING --- */
    .footer-col { flex: 1; }
    
    .brand-col {
        display: flex;
        align-items: center;
        gap: 20px; 
    }

    .footer-logo {
        font-family: 'lequire', sans-serif;
        font-size: 1.6rem; 
        font-weight: bold;
        margin: 0;
        background: linear-gradient(to right, #191f4f 0%, #436aee 20%, #91e0fd 50%, #dbbbf6 60%, #2c3c94 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .social-icons { display: flex; gap: 12px; }

    .social-icons img {
        width: 20px; 
        height: 20px;
        object-fit: contain;
        opacity: 0.6;
        transition: 0.2s;
    }

    .social-icons img:hover { opacity: 1; transform: scale(1.1); }

    /* --- LINKS --- */
    .links-col ul, .contact-col ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex; 
        gap: 20px;
        justify-content: center;
    }

    .footer-col a {
        text-decoration: none;
        color: #191f4f;
        font-size: 0.85rem; 
        font-weight: 600;
        opacity: 0.8;
        transition: 0.2s;
    }

    .footer-col a:hover { color: #436aee; opacity: 1; }

    /* --- CONTACT & COPYRIGHT --- */
    .contact-col { text-align: right; }
    
    .contact-col ul {
        justify-content: flex-end; 
        flex-wrap: wrap;
        gap: 15px;
        align-items: center; /* Ensures text aligns with links */
    }

    .contact-col li {
        font-size: 0.85rem;
        color: #191f4f;
        opacity: 0.8;
    }

    .copyright-text {
        opacity: 0.5 !important;
        font-size: 0.75rem !important;
        margin-left: 5px;
        border-left: 1px solid #ccc; /* Separator line */
        padding-left: 15px;
    }

    /* --- WAVE LINKS --- */
    .wave-links {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        gap: 30px; 
    }

    .wave-links a {
        text-decoration: none;
        color: #191f4f;
        font-weight: 600;
        display: inline-block;
        overflow: hidden; 
    }

    .wave-links a span {
        display: inline-block;
        position: relative;
        transition: transform 0.3s cubic-bezier(0.2, 1, 0.3, 1);
        transition-delay: calc(var(--i) * 0.03s); 
    }

    .wave-links a:hover span {
        transform: translateY(-5px);
        color: #436aee; 
    }

    /* --- MOBILE --- */
    @media (max-width: 768px) {
        .footer-content {
            flex-direction: column;
            gap: 15px;
            text-align: center;
        }

        .brand-col { 
            justify-content: center; 
            flex-direction: column; 
            gap: 10px; 
        }

        .links-col ul { justify-content: center; gap: 15px; }
        .contact-col ul { justify-content: center; flex-direction: column; gap: 8px; }
        
        .copyright-text {
            border-left: none;
            padding-left: 0;
            margin-left: 0;
            margin-top: 5px;
        }
    }
</style>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const links = document.querySelectorAll('.wave-links a');

    links.forEach(link => {
        const text = link.textContent.trim();
        link.innerHTML = '';
        text.split('').forEach((letter, index) => {
            const span = document.createElement('span');
            span.textContent = letter === ' ' ? '\u00A0' : letter; 
            span.style.setProperty('--i', index); 
            link.appendChild(span);
        });
    });
});
</script>