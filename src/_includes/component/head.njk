      padding: 0 10px;
    }

    .prev, .next {
      cursor: pointer;
      position: absolute;
      top: 50%;
      width: auto;
      padding: 16px;
      margin-top: -22px;
      font-weight: bold;
      font-size: 22px;
      transition: 0.3s ease;
      user-select: none;
      color: black;
    }

    .next { right: 0; }
    .prev { left: 0; }

    .prev:hover, .next:hover {
      background-color: rgba(0,0,0,0.1);
    }

    .text { display: none; } /* Not used here */
    .numbertext {
      color: #999;
      font-size: 12px;
