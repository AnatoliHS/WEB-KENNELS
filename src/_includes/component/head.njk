      cursor: pointer;
      height: 12px;
      width: 12px;
      margin: 0 4px;
      background-color: #bbb;
      border-radius: 50%;
      display: inline-block;
      transition: background-color 0.6s ease;
    }

    .active, .dot:hover {
      background-color: #717171;
    }

    @keyframes fade {
      from {opacity: .4} 
      to {opacity: 1}
    }

    .fade {
      animation-name: fade;
      animation-duration: 1s;
