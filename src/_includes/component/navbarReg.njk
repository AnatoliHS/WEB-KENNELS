    <script>
const whmisData = [
  { src: "/assets/flame.png", caption: "Flammable material" },
  { src: "/assets/corrosion.png", caption: "Corrosive to skin or metals" },
  { src: "/assets/exclamation_mark.png", caption: "Irritant or acute toxicity" },
  { src: "/assets/flame_circle.png", caption: "Oxidizing hazard" },
  { src: "/assets/health_hazard.png", caption: "Carcinogenic or serious health effects" },
  { src: "/assets/gas_cylinder.png", caption: "Gases under pressure" },
  { src: "/assets/skull_crossbones.png", caption: "Toxic or fatal effects" },
  { src: "/assets/environment.png", caption: "Hazardous to the environment" },
  { src: "/assets/exploding_bomb.png", caption: "Explosive hazard" },
  { src: "/assets/biohazardous.png", caption: "Biohazardous infectious materials" }
];

const track = document.getElementById("whmis-track");
const slideWidth = 300;

// Add slides twice (for seamless loop)
[...whmisData, ...whmisData].forEach(item => {
  const slide = document.createElement("div");
  slide.className = "whmis-slide";
  slide.innerHTML = `
    <img src="${item.src}" alt="">
    <div class="whmis-caption">${item.caption}</div>
  `;
  track.appendChild(slide);
});

let index = 0;
let pauseTime = 4000; // milliseconds
const totalSlides = whmisData.length;

// Carousel loop
function moveSlide() {
  index++;
  track.style.transition = "transform 0.6s ease-in-out";
  track.style.transform = `translateX(-${index * slideWidth}px)`;

  // Reset to start instantly after first loop set is done
  if (index === totalSlides) {
    setTimeout(() => {
      track.style.transition = "none";
      track.style.transform = "translateX(0)";
      index = 0;
    }, 600); // Wait for slide transition to complete
  }
}

setInterval(moveSlide, pauseTime);
</script>

