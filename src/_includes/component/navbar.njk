<style>
  /* --- 1. FONT DEFINITIONS (MUST BE AT THE VERY TOP) --- */

  /* --- GLOBAL VARIABLES --- */
  @property --angle-1 {
    syntax: "<angle>";
    inherits: false;
    initial-value: -75deg;
  }

  @property --angle-2 {
    syntax: "<angle>";
    inherits: false;
    initial-value: -45deg;
  }

  :root {
    --border-width: clamp(1px, 0.0625em, 4px);
    --anim--hover-time: 400ms;
    --anim--hover-ease: cubic-bezier(0.25, 1, 0.5, 1);
  }

  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 15px 30px;
    width: 100%;
    box-sizing: border-box;
    z-index: 100;
    background: rgba(255, 255, 255, 0.489);
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: all 0.3s ease;
  }



  /* =========================================
     BUTTON STYLES
     ========================================= */
  .type--A {
    --line_color: #555555;
    --back_color: #ffecf6;
  }

  .type--B {
    --line_color: #1b1919;
    --back_color: #dbbbf6;
  }

  .type--C {
    --line_color: #233d4c;
    --back_color: #ffb400;
  }

  .button {
    font-size: 14px;
    color: var(--line_color);
    font-family: inherit;
    font-weight: bold;
    cursor: pointer;
    position: relative;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    text-shadow: none !important;
    background: transparent !important;
    text-transform: uppercase;
    text-decoration: none;
    margin: 0 5px;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    height: 40px;
    width: 140px;
    -webkit-tap-highlight-color: transparent;
  }

  .btn-text {
    position: relative;
    display: inline-block;
    letter-spacing: 2px;
    padding-left: 2px;
    transition-timing-function: cubic-bezier(0.25, 0.8, 0.25, 1);
    transition-duration: 400ms;
    transition-property: letter-spacing, padding-left, color;
  }

  .button:focus .btn-text,
  .button:hover .btn-text,
  .button.clicked .btn-text {
    letter-spacing: 6px;
    padding-left: 6px;
  }

  .button:focus .btn-text::after,
  .button:hover .btn-text::after,
  .button.clicked .btn-text::after {
    width: 100%;
    left: 0%;
  }

  .btn-text::after {
    content: "";
    pointer-events: none;
    bottom: -5px;
    left: 50%;
    position: absolute;
    width: 0%;
    height: 2px;
    background-color: var(--line_color);
    transition-timing-function: cubic-bezier(0.25, 0.8, 0.25, 1);
    transition-duration: 400ms;
    transition-property: width, left;
  }

  /* --- DESKTOP LOGO --- */
  .desktop-logo {
    display: block;
    position: absolute;
    left: 30px;
    top: 50%;
    transform: translateY(-50%);
    font-family: 'Great Vibes', cursive;
    font-size: 38px;
    color: #1a1a1a;
    text-decoration: none;
    line-height: 1;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .desktop-logo:hover {
    transform: translateY(-50%) scale(1.05);
  }

  /* --- DESKTOP BUTTONS --- */
  .nav-image-button,
  .nav-image-button-right {
    display: inline-block;
    cursor: pointer;
    margin: 0 10px;
    z-index: 10;
    position: relative;
  }

  .nav-image-button img,
  .nav-image-button-right img {
    width: 60px;
    height: 60px;
    object-fit: contain;
    display: block;
    transition: transform 0.3s ease;
  }

  .nav-image-button-right {
    margin-left: 20px;
  }

  .nav-image-button img:hover,
  .nav-image-button-right img:hover {
    transform: scale(1.3);
  }

  /* --- MOBILE ELEMENTS --- */
  .mobile-right-group {
    display: none;
  }

  .hamburger {
    display: none;
  }

  .nav-image-button-mobile {
    display: none;
  }

  /* --- MEDIA QUERIES --- */

  /* =========================================
     MOBILE BREAKPOINT
     ========================================= */
  @media (max-width: 1024px) {
    .desktop-logo {
      display: none !important;
    }

    .navbar {
      margin: 0;
      width: 100%;
      box-sizing: border-box;
      flex-direction: column;
      align-items: flex-start;
      padding: 10px 20px;
      position: fixed;
      top: 0;
      left: 0;
      height: auto;
      max-height: 100vh;
      border: none;
      border-radius: 0 0 0 0;
      background: rgba(255, 255, 255, 0.489);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      transition: border-radius 0.4s ease, background 0.4s ease;
    }

    .navbar.open {
      border-radius: 0 0 30px 30px;
    }

    .navbar-top-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 5px 0;
      position: relative;
      z-index: 10;
    }

    .beam {
      width: 90%;
      font-size: 20px;
      letter-spacing: 2px;
      justify-content: flex-end;
      padding-right: 20px;
      padding-left: 0;
      background: linear-gradient(to right, rgba(var(--beam-rgb), 0) 0%, rgba(var(--beam-rgb), 1) 50%);
    }

    .navbar.open .beam {
      opacity: 0;
    }

    .mobile-right-group {
      display: flex !important;
      align-items: center;
      gap: 15px;
    }

    .navbar-links {
      width: 100%;
      max-height: 0;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      opacity: 0;
      transform: scaleY(0);
      transform-origin: top;
      transition: max-height 0.4s ease, opacity 0.3s ease, transform 0.4s ease;
      z-index: 10;
      position: relative;
    }

    .navbar.open .navbar-links {
      max-height: 100vh;
      opacity: 1;
      transform: scaleY(1);
      overflow-y: hidden;
    }

    .button {
      width: 240px;
      margin: 15px auto;
      display: inline-flex;
      justify-content: center;
      align-items: center;
      opacity: 0;
      transform: translateY(-20px);
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    .navbar.open .button {
      opacity: 1;
      transform: translateY(0);
    }

    .navbar.open .button:nth-child(1) {
      transition-delay: 0.1s;
    }

    .navbar.open .button:nth-child(2) {
      transition-delay: 0.2s;
    }

    .navbar.open .button:nth-child(3) {
      transition-delay: 0.3s;
    }

    .navbar.open .button:nth-child(4) {
      transition-delay: 0.4s;
    }

    .navbar.open .button:nth-child(5) {
      transition-delay: 0.5s;
    }

    .hamburger {
      display: flex !important;
      flex-direction: column;
      justify-content: space-between;
      width: 30px;
      height: 22px;
      cursor: pointer;
      z-index: 10;
    }

    .hamburger span {
      display: block;
      height: 3px;
      background: #000;
      border-radius: 2px;
      transition: all 0.4s ease;
    }

    .navbar.open .hamburger span:nth-child(1) {
      transform: rotate(45deg) translate(5px, 5px);
    }

    .navbar.open .hamburger span:nth-child(2) {
      opacity: 0;
    }

    .navbar.open .hamburger span:nth-child(3) {
      transform: rotate(-45deg) translate(8px, -8px);
    }

    .nav-image-button,
    .nav-image-button-right {
      display: none !important;
    }

    .nav-image-button-mobile {
      display: none;
      cursor: pointer;
    }

    .navbar.open .nav-image-button-mobile {
      display: block !important;
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      animation: slideToCenter 0.5s cubic-bezier(0.25, 1, 0.5, 1) forwards;
      z-index: 20;
    }

    .nav-image-button-mobile .logo-text {
      display: block;
      font-family: 'Great Vibes', cursive !important;
      font-weight: 400;
      margin: 0;
      line-height: 1;
      color: #1a1a1a;
      font-size: 48px;
      white-space: nowrap;
      text-transform: none;
    }

    .nav-image-button-mobile .highlight-blue {
      color: inherit;
    }

    @keyframes slideToCenter {
      0% {
        opacity: 0;
        left: 85%;
        transform: translate(-50%, -50%) scale(0.5);
      }

      100% {
        opacity: 1;
        left: 50%;
        transform: translate(-50%, -50%) scale(1);
      }
    }
  }
</style>

<nav class="navbar">

  <div class="desktop-logo" onclick="navigateToHome()">
    Feminink
  </div>

  <div class="navbar-top-row">
    <div class="hamburger" aria-label="Toggle Menu">
      <span></span>
      <span></span>
      <span></span>
    </div>

    <div class="mobile-right-group">
    </div>

    <div class="nav-image-button-mobile" onclick="navigateToHome()">
      <h2 class="logo-text">Feminink</h2>
    </div>
  </div>

  <div class="navbar-links">
    <a href="/" class="button type--C"><span class="btn-text">HOME</span></a>
    <a href="/artists/" class="button type--C"><span class="btn-text">PORTFOLIOS</span></a>
    <a href="/about/" class="button type--C"><span class="btn-text">ABOUT</span></a>
    <a href="/booking/" class="button type--C"><span class="btn-text">BOOKING</span></a>
    <a href="/policies/" class="button type--C"><span class="btn-text">POLICIES</span></a>
  </div>
</nav>

<script>
  const hamburger = document.querySelector('.hamburger');
  const navbar = document.querySelector('.navbar');
  hamburger.addEventListener('click', () => { navbar.classList.toggle('open'); });

  function navigateToHome() { window.location.href = "/index/"; }

  document.addEventListener("DOMContentLoaded", function () {
    // 1. Splitting Logic
    const beams = document.querySelectorAll('.beam');
    beams.forEach(beam => {
      const text = beam.getAttribute('data-text');
      beam.innerHTML = '';
      text.split('').forEach((char, i) => {
        const span = document.createElement('span');
        span.textContent = char === ' ' ? '\u00A0' : char;
        span.style.animationDelay = `${i * 0.12}s`;
        beam.appendChild(span);
      });
    });

    // 2. Active Page Detection & Animation Trigger
    const links = document.querySelectorAll('.navbar-links a');
    const currentPath = window.location.pathname;

    links.forEach((link, index) => {
      const href = link.getAttribute('href');
      let isActive = false;

      if (index === 0 && (currentPath === "/" || currentPath.includes("index"))) isActive = true;
      else if (href !== "/" && currentPath.includes(href)) isActive = true;

      if (isActive) {
        const pageNum = index + 1;
        navbar.classList.add(`active-page-${pageNum}`);

        // Trigger character fade-in after splitting is complete
        setTimeout(() => {
          const activeBeam = document.querySelector(`.beam-${pageNum}`);
          if (activeBeam) activeBeam.classList.add('animate-letters');
        }, 150);
      }

      link.addEventListener('click', function (e) {
        if (window.innerWidth <= 1024) {
          e.preventDefault();
          this.classList.add('clicked');
          setTimeout(() => { window.location.href = href; }, 600);
        }
      });
    });
  });
</script>