<style>
  /* --- GLOBAL VARIABLES --- */
  @property --angle-1 { syntax: "<angle>"; inherits: false; initial-value: -75deg; }
  @property --angle-2 { syntax: "<angle>"; inherits: false; initial-value: -45deg; }
  :root { --border-width: clamp(1px, 0.0625em, 4px); --anim--hover-time: 400ms; --anim--hover-ease: cubic-bezier(0.25, 1, 0.5, 1); }

  /* --- NAVBAR CONTAINER --- */
  .navbar {
    position: sticky;
    top: 0;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    padding: 15px 10px;
    width: calc(100% - 60px);
    margin: 10px auto;
    z-index: 100;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
    transition: all 0.3s ease;
  }

  /* --- LINKS STYLING --- */
  .navbar a {
    all: unset;
    cursor: pointer;
    position: relative;
    z-index: 3;
    pointer-events: auto;
    border-radius: 999vw;
    background: linear-gradient(-75deg, rgba(1, 213, 255, 0.05), rgba(1, 213, 255, 0.2), rgba(1, 213, 255, 0.05));
    box-shadow: inset 0 0.125em 0.125em rgba(0, 0, 0, 0.05), inset 0 -0.125em 0.125em rgba(255, 255, 255, 0.5), 0 0.25em 0.125em -0.125em rgba(0, 0, 0, 0.2), 0 0 0.1em 0.25em inset rgba(255, 255, 255, 0.2), 0 0 0 0 rgba(255, 255, 255, 1);
    backdrop-filter: blur(clamp(1px, 0.125em, 4px));
    transition: all var(--anim--hover-time) var(--anim--hover-ease);
    width: 100px;
    padding: 10px;
    text-align: center;
    text-decoration: none;
    color: #323232;
    display: inline-block;
  }
  .navbar a:hover { transform: scale(0.975); }
  .navbar a span { display: block; position: relative; font-weight: 500; color: #323232; padding: 0.1em 0.1em; }
  .navbar a::after {
    content: ""; position: absolute; inset: 0; border-radius: 999vw;
    width: calc(100% + var(--border-width)); height: calc(100% + var(--border-width));
    top: calc(0% - var(--border-width) / 2); left: calc(0% - var(--border-width) / 2);
    padding: var(--border-width);
    background: conic-gradient(from var(--angle-1) at 50% 50%, rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0) 5% 40%, rgba(0, 0, 0, 0.5) 50%, rgba(0, 0, 0, 0) 60% 95%, rgba(0, 0, 0, 0.5)), linear-gradient(180deg, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.5));
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); mask-composite: exclude;
    transition: all var(--anim--hover-time) var(--anim--hover-ease), --angle-1 500ms ease;
  }
  .navbar a:hover::after { --angle-1: -125deg; } .navbar a:active::after { --angle-1: -75deg; }
  .button-wrap { position: relative; z-index: 2; border-radius: 999vw; background: transparent; pointer-events: none; transition: all var(--anim--hover-time) var(--anim--hover-ease); display: inline-block; margin: 0 5px; }
  .button-shadow { position: absolute; width: calc(100% + 2em); height: calc(100% + 2em); top: -1em; left: -1em; filter: blur(12px); pointer-events: none; }

  /* --- DESKTOP BUTTONS --- */
  .nav-image-button, .nav-image-button-right { display: inline-block; cursor: pointer; margin: 0 10px; }
  .nav-image-button img, .nav-image-button-right img { width: 50px; height: 50px; object-fit: contain; display: block; transition: transform 0.3s ease; }
  .nav-image-button-right { margin-left: 20px; }
  .nav-image-button img:hover, .nav-image-button-right img:hover { transform: scale(1.3); }

  /* --- DESKTOP CAROUSEL --- */
  .whmis-carousel { width: 300px; height: 100%; overflow: hidden; position: relative; margin-left: auto; }
  .whmis-track { display: flex; transition: transform 0.6s ease-in-out; will-change: transform; }
  .whmis-slide { flex: 0 0 300px; display: flex; align-items: center; gap: 10px; padding: 0 10px; box-sizing: border-box; }
  .whmis-slide img { height: 55px; width: 55px; object-fit: contain; }
  .whmis-caption { font-size: 15px; color: black; max-width: 200px; font-weight: bold; }

  /* --- MOBILE ELEMENTS (HIDDEN ON DESKTOP) --- */
  .mobile-right-group { display: none; } 
  .hamburger { display: none; }

  /* --- MEDIA QUERIES --- */
  @media (max-width: 1310px) { .navbar { width: calc(100% - 40px); } }

  /* --- MOBILE BREAKPOINT --- */
  @media (max-width: 1024px) {
    .navbar { flex-direction: column; align-items: flex-start; padding: 2px 10px; position: fixed; height: auto; max-height: 100vh; }
    
    .navbar-top-row { display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 5px 0; }

    /* Right Icons Container */
    .mobile-right-group { 
      display: flex !important; 
      align-items: center; 
      gap: 15px; 
    }

    /* --- THE NEW MOBILE BUTTON --- */
    .nav-image-button-mobile { display: none; cursor: pointer; }
    .navbar.open .nav-image-button-mobile { display: block !important; animation: fadeInSide 0.4s ease forwards; }
    .nav-image-button-mobile img { height: 36px !important; width: auto !important; display: block !important; object-fit: contain; }

    @keyframes fadeInSide {
      0% { opacity: 0; transform: translateX(20px); }
      100% { opacity: 1; transform: translateX(0); }
    }

    /* THE OLD MOBILE LOGO */
    .mobile-navbar-image { display: block !important; height: 36px; width: auto; }

    /* Hamburger */
    .hamburger { display: flex !important; flex-direction: column; justify-content: space-between; width: 30px; height: 22px; cursor: pointer; z-index: 10; }
    .hamburger span { display: block; height: 3px; background: #000; border-radius: 2px; transition: all 0.4s ease; }
    .navbar.open .hamburger span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
    .navbar.open .hamburger span:nth-child(2) { opacity: 0; }
    .navbar.open .hamburger span:nth-child(3) { transform: rotate(-45deg) translate(8px, -8px); }

    /* Hide Desktop Stuff */
    .nav-image-button, .nav-image-button-right, .whmis-carousel { display: none !important; }

    /* Dropdown Animation */
    .navbar-links { 
        width: 100%; 
        max-height: 0; 
        overflow: hidden; 
        display: flex; 
        flex-direction: column; 
        align-items: center;
        opacity: 0; 
        transform: scaleY(0); 
        transform-origin: top; 
        transition: max-height 0.4s ease, opacity 0.3s ease, transform 0.4s ease; 
        -ms-overflow-style: none; 
        scrollbar-width: none;
    }
    .navbar-links::-webkit-scrollbar { display: none;}
    .navbar.open .navbar-links { max-height: 80vh; opacity: 1; transform: scaleY(1); overflow-y: auto; }
    
    /* --- SHADOW FIX IS HERE --- */
    
    /* 1. Wrapper controls the geometry (90% width, Centered) */
    .navbar-links .button-wrap { 
        width: 90%; 
        margin: 10px auto; 
        display: block; 
    }
    
    /* 2. Link fills the wrapper completely */
    .navbar a { 
        display: block; 
        width: 100%; 
        box-sizing: border-box; /* Ensures padding is included in width */
        text-align: center; 
        padding: 12px 16px; 
        margin: 0; /* Remove auto margin, parent handles it now */
    }
    
    @media (orientation: landscape) { .intro-container, .scene { margin-top: 100px !important; } }
  }
</style>

<nav class="navbar">
  <div class="navbar-top-row">
    
    <div class="hamburger" aria-label="Toggle Menu">
      <span></span>
      <span></span>
      <span></span>
    </div>

    <div class="mobile-right-group">
      
      <div class="nav-image-button-mobile" onclick="location.href='https://learn.whmiswise.com/auth/login/'">
        <img src="/assets/login1.png" alt="New Button">
      </div>

      <img src="/assets/WW.png" alt="Old Logo" class="mobile-navbar-image" onclick="navigateToHome()">
    </div>

  </div>

  <div class="nav-image-button" onclick="navigateToHome()">
    <img src="/assets/WW.png" alt="Info">
  </div>

  <div class="navbar-links">
    <div class="button-wrap"><a href="/homeDent/"><span>Home</span></a><div class="button-shadow"></div></div>
    <div class="button-wrap"><a href="/about/"><span>About</span></a><div class="button-shadow"></div></div>
    <div class="button-wrap"><a href="/faq/"><span>FAQ</span></a><div class="button-shadow"></div></div>
    <div class="button-wrap"><a href="/contact/"><span>Contact</span></a><div class="button-shadow"></div></div>
  </div>

  <div class="whmis-carousel">
    <div class="whmis-track" id="whmis-track"></div>
  </div>

  <div class="nav-image-button-right" onclick="location.href='https://learn.whmiswise.com/auth/login/'">
    <img src="/assets/login1.png" alt="Right Button">
  </div>
</nav>

<script>
  const whmisData = [
    {src: "/assets/flame.png", caption: "Flammable material"},
    {src: "/assets/corrosion.png", caption: "Corrosive to skin or metals"},
    {src: "/assets/exclamation_mark.png", caption: "Irritant or acute toxicity"},
    {src: "/assets/flame_circle.png", caption: "Oxidizing hazard"},
    {src: "/assets/health_hazard.png", caption: "Carcinogenic or serious health effects"},
    {src: "/assets/gas_cylinder.png", caption: "Gases under pressure"},
    {src: "/assets/skull_crossbones.png", caption: "Toxic or fatal effects"},
    {src: "/assets/environment.png", caption: "Hazardous to the environment"},
    {src: "/assets/exploding_bomb.png", caption: "Explosive hazard"},
    {src: "/assets/biohazardous.png", caption: "Biohazardous infectious materials"}
  ];

  const track = document.getElementById("whmis-track");
  const slideWidth = 300;
  [...whmisData, ...whmisData].forEach(item => {
    const slide = document.createElement("div");
    slide.className = "whmis-slide";
    slide.innerHTML = `<img src="${item.src}" alt=""><div class="whmis-caption">${item.caption}</div>`;
    track.appendChild(slide);
  });

  let index = 0; let pauseTime = 4000; const totalSlides = whmisData.length;
  function moveSlide() {
    index++; track.style.transition = "transform 0.6s ease-in-out";
    track.style.transform = `translateX(-${index * slideWidth}px)`;
    if (index === totalSlides) {
      setTimeout(() => { track.style.transition = "none"; track.style.transform = "translateX(0)"; index = 0; }, 600);
    }
  }
  setInterval(moveSlide, pauseTime);

  const hamburger = document.querySelector('.hamburger');
  const navbar = document.querySelector('.navbar');
  hamburger.addEventListener('click', () => { navbar.classList.toggle('open'); });

  function navigateToHome() { window.location.href = "/index/"; }
</script>