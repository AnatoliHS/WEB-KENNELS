    <style>
        .navbar {
          position: sticky;
          top: 0;
          display: flex;
          justify-content: flex-start;
          align-items: center;
          padding: 15px 10px;
          width: calc(100% - 60px);
          margin: 10px auto;
          z-index: 100;
          
          background: rgba(255, 255, 255, 0.15); /* semi-transparent glass look */
          border-radius: 16px;
          border: 1px solid rgba(255, 255, 255, 0.3); /* frosty white border */

          backdrop-filter: blur(12px); /* stronger blur */
          -webkit-backdrop-filter: blur(12px); /* Safari support */

          box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25); /* soft shadow */
          transition: all 0.3s ease;
      }

        
        .navbar a {
          display: inline-block;
          padding: 12px 20px;
          margin: 0 5px;
          color:rgb(61, 59, 59);
          text-decoration: none;
          text-align: center;

          background: linear-gradient(145deg, rgba(37, 150, 190, 0.6), rgba(9, 184, 248, 0.35));
          border: 1px solid rgba(255, 255, 255, 0.25);
          border-radius: 40px;
          backdrop-filter: blur(12px);
          -webkit-backdrop-filter: blur(12px);

          box-shadow:
            inset 0 1px 2px rgba(255, 255, 255, 0.3),
            0 4px 12px rgba(13, 54, 69, 0.3),
            0 8px 24px rgba(13, 54, 69, 0.2);

          transform: skew(-25deg);
          transition: all 0.3s ease;
          position: relative;
          overflow: hidden;

          -webkit-tap-highlight-color: transparent;
          -webkit-touch-callout: none;
          user-select: none;
        }

/* Shine effect on top of button */
.navbar a::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(
    120deg,
    rgba(255, 255, 255, 0.3) 0%,
    rgba(255, 255, 255, 0.15) 40%,
    rgba(255, 255, 255, 0.05) 100%
  );
  opacity: 0.5;
  pointer-events: none;
}

/* Fix skewed text */
.navbar a span {
  display: inline-block;
  transform: skew(25deg);
}


/* Hover effect */
      .navbar a:hover {
          background: rgba(255, 195, 77, 0.9); /* darker blue on hover */
          color: black;
          box-shadow: 0 6px 18px rgba(51, 54, 56, 0.9);
      }

  .navbar a:hover::before {
  animation: shineMove 2s ease forwards;
}

@keyframes shineMove {
  0% {
    transform: translateX(-100%) skewX(-20deg);
    opacity: 0.5;
  }
  100% {
    transform: translateX(200%) skewX(-20deg);
    opacity: 0;
  }
}

@media (hover: none) and (pointer: coarse) {
  .navbar a:hover {
    background: inherit;
    color: inherit;
    box-shadow: none;
  }
}
    
    @media (max-width: 1310px) {
        .navbar {
            
             width: calc(100% - 40px);
            }
        }

        @media (max-width: 768px) {
  .navbar {
    flex-wrap: nowrap;        /* Prevent wrapping */
    overflow-x: auto;         /* Let it scroll horizontally if needed */
    
  }

  .navbar a {
    flex: 1 1 0;
    min-width: 0;
    padding: 10px 6px;
    margin: 0 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Optional: hide scrollbar for cleaner look */
  .navbar::-webkit-scrollbar {
    display: none;
  }
  .navbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
}

        .whmis-carousel {
  width: 300px;
  height: 100%;
  overflow: hidden;
  position: relative;
  margin-left: auto;
 
  
}

.whmis-track {
  display: flex;
  transition: transform 0.6s ease-in-out;
  will-change: transform;
}

.whmis-slide {
  flex: 0 0 300px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 0 10px;
  box-sizing: border-box;
}

.whmis-slide img {
  height: 55px;
  width: 55px;
  object-fit: contain;
}

.whmis-caption {
